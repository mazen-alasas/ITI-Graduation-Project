# ─── SQL Server Connection ────────────────────────────────────────────────────
# Copy this file, rename it to .env, and fill in your values.
# Do NOT commit .env to GitHub — it contains your server info.

# Your SQL Server instance name.
# Examples:
#   localhost                        (default local instance)
#   DESKTOP-XXXX\SQLEXPRESS          (SQL Server Express named instance)
#   .\SQLEXPRESS                     (shorthand for local Express)
DB_SERVER=YOUR_SERVER_NAME_HERE

# The OLTP database name (not the DWH).
DB_NAME=RestaurantProfitability_EG

# Leave this as-is unless you installed a different ODBC driver version.
# To check which drivers are installed, run in Python:
#   import pyodbc; print(pyodbc.drivers())
DB_DRIVER=ODBC Driver 17 for SQL Server
