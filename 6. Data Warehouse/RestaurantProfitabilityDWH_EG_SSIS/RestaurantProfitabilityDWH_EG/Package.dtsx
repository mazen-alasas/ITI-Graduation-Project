                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    
cm.CompetitorMenuItemID,
    
cm.CompetitorID,
    
cm.YourItemID,          -- our equivalent menu item
    cm.DateTracked,
    
cm.CompetitorItemName,
    
cm.CompetitorPrice_EGP,
    
cm.IsOnPromotion,
mi.CurrentPrice_EGP AS OurPrice_EGP
FROM CompetitorMenuItem cm
JOIN MenuItem mi ON cm.YourItemID = mi.ItemID</property>
