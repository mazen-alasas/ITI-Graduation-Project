                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
    c.CompetitorID,
    c.CompetitorName_AR,
    c.CompetitorName_EN,
    c.ZoneID,
    c.HasDelivery,
    c.AverageDeliveryMinutes,
    c.GoogleMapsRating,
    STRING_AGG(dp.PlatformName_EN, ', ') WITHIN GROUP (ORDER BY dp.PlatformName_EN) AS PlatformsUsed
FROM Competitor c
LEFT JOIN CompetitorPlatform cp ON c.CompetitorID = cp.CompetitorID
LEFT JOIN DeliveryPlatform dp ON cp.PlatformID = dp.PlatformID
GROUP BY 
    c.CompetitorID,
    c.CompetitorName_AR,
    c.CompetitorName_EN,
    c.ZoneID,
    c.HasDelivery,
    c.AverageDeliveryMinutes,
    c.GoogleMapsRating</property>
